{
  "name": "GameChat",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "Reference to the Game entity"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_avatar": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "game_id",
    "message"
  ]
}