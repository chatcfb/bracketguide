{
  "name": "MarketplaceItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "reel",
        "prediction_pack",
        "article_template",
        "design",
        "podcast_script",
        "avatar_preset",
        "merch"
      ]
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "enum": [
        "points",
        "usd"
      ]
    },
    "creator": {
      "type": "string"
    },
    "creator_avatar": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "sales_count": {
      "type": "number"
    },
    "rating": {
      "type": "number"
    },
    "reviews_count": {
      "type": "number"
    },
    "team_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_featured": {
      "type": "boolean"
    },
    "preview_url": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type",
    "price"
  ]
}